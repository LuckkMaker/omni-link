# ── Node.js ──────────────────────────────
node_modules/
out/
dist/

# ── TypeScript ───────────────────────────
*.tsbuildinfo
.tsbuildinfo

# ── Python ───────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── 构建产物 ─────────────────────────────
release/
# 后端/CLI 的 PyInstaller 产物统一输出到这里（python/dist/omni-backend、python/dist/omni.exe），
# 由 build.ps1 调 vendor/omni-backend/link/build.py --out 生成；源码已不在本仓库。
python/dist/
# build/ 是 electron-builder 的 buildResources 目录；installer.nsh 需要随仓库分发，
# 否则其他机器/CI 打包会报 "cannot find include file"。用 build/* 而非 build/，
# 才能对该文件做反向忽略（git 无法从被忽略的目录里再包含文件）。
build/*
!build/installer.nsh

# ── Electron 打包产物 ────────────────────
*.app
*.dmg
*.exe
*.AppImage
*.snap
*.deb
*.rpm

# ── PyInstaller 临时文件 ─────────────────
*.spec.bak
*.spec

# ── 运行时数据 ───────────────────────────
# 后端运行时数据（devices.db / 已装 Pack / user-devices.xml）现在落在
# vendor/omni-backend/link/data/ 或 OMNI_DATA_DIR，由后端仓库自己的 .gitignore 负责。

# ── CMSIS-Pack 文件 ──────────────────────
*.pack

# ── 环境配置 ─────────────────────────────
.env
.env.*
!.env.example

# ── 代码签名证书（含私钥，切勿提交）──────
*.pfx
*.p12
*.pvk
*.snk
certs/

# ── 日志 ─────────────────────────────────
*.log
logs/

# ── 临时/备份文件 ────────────────────────
*.tmp
*.bak
*~
*.orig

# ── 临时验证配置（构建探测用，不提交）──
vite.fault-check.config.ts
.tmp-fault-build/

# ── 文档构建产物（mkdocs build 输出）──
site/

# ── 覆盖率 ─────────────────────────────
coverage/

# ── 缓存 ─────────────────────────────────
.cache/
.eslintcache
.parcel-cache/
.vite/
.vitest-cache/

# ── electron-vite 临时构建配置 ───────────
electron.vite.config.*.mjs

# ── IDE ──────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.iml
*.code-workspace
.cursor/
.zed/

# ── Python 分发包 ───────────────────────
*.whl
*.tar.gz

# ── macOS ────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ──────────────────────────────
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# ── Linux ────────────────────────────────
*~
.fuse_hidden000
.directory
.Trash-*
.nfs*

# ── 调试 / Profile ───────────────────────
*.prof
*.profraw
/.workbuddy

# ── DSH 内嵌运行时（构建期生成，体积大，不提交）──
# .dsh-runtime/ 由 scripts/dsh-runtime.ps1 生成：Node 24 + @deepseek-ai/dsh 全树 + 预烘焙 DSH_HOME
.dsh-runtime/
# 可行性 spike 的临时安装目录
.dsh-spike/
